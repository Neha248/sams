    "@tailwindcss/typography": "latest",
    "@tailwindcss/vite": "4.2.4",
    "@types/node": "latest",
    "@types/pdfkit": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/sql.js": "latest",
    "@vitejs/plugin-react": "4.7.0",
